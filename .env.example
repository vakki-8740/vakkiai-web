# Local development ke liye .env.example ko .env copy karo.
# Render par ye values Dashboard > Environment me set karo; .env commit mat karo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

VAKKIAI_DEFAULT_LANGUAGE=hi-IN
VAKKIAI_ALLOWED_ORIGINS=*
VAKKIAI_RATE_LIMIT_PER_MINUTE=20
# VAKKIAI_CONNECT_TIMEOUT=10
# VAKKIAI_READ_TIMEOUT=60
# VAKKIAI_MAX_COMMAND_CHARS=4000
# VAKKIAI_MAX_NOTES_CHARS=12000
# VAKKIAI_MAX_HISTORY_MESSAGES=8
